// ============================================================
// Credential Access
// MITRE ATT&CK: T1003 (OS Credential Dumping),
//               T1110 (Brute Force)
// ============================================================

// LSASS memory access by non-standard processes — a strong
// indicator of credential dumping tools (e.g. Mimikatz-style behavior).
DeviceProcessEvents
| where Timestamp > ago(7d)
| where ActionType == "OpenProcess"
| where FileName has "lsass.exe"
| where InitiatingProcessFileName !in~ ("werfault.exe", "MsMpEng.exe", "csrss.exe")
| project Timestamp, DeviceName, InitiatingProcessFileName, InitiatingProcessCommandLine, AccountName
| order by Timestamp desc

// ------------------------------------------------------------

// Sign-in anomalies: same account authenticating from multiple
// countries within a short window ("impossible travel").
let timeWindow = 1h;
SigninLogs
| where TimeGenerated > ago(7d)
| summarize Countries = make_set(Location), SignInCount = count() by UserPrincipalName, bin(TimeGenerated, timeWindow)
| where array_length(Countries) > 1
| project TimeGenerated, UserPrincipalName, Countries, SignInCount
| order by TimeGenerated desc

// ------------------------------------------------------------

// Repeated failed sign-ins followed by a success — classic
// brute-force / password-spray pattern.
SigninLogs
| where TimeGenerated > ago(1d)
| summarize FailedAttempts = countif(ResultType != "0"),
            SuccessAfterFail = countif(ResultType == "0")
          by UserPrincipalName, IPAddress
| where FailedAttempts >= 5 and SuccessAfterFail >= 1
| order by FailedAttempts desc
